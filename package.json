{
  "name": "nuxt-laravelize-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Nuxt module that brings Laravel-like architecture primitives to Nuxt and Nitro",
  "repository": "nuxt-laravelize/nuxt-laravelize",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm run dev:prepare && pnpm --dir playground dev",
    "dev:build": "pnpm run build:packages && pnpm --dir playground build",
    "dev:prepare": "pnpm run build:packages && pnpm --dir playground exec nuxt prepare",
    "build": "pnpm run build:packages",
    "pack": "pnpm run pack:test",
    "release": "pnpm run release:packages",
    "lint": "eslint .",
    "test": "pnpm run test:packages && pnpm run test:integration",
    "test:watch": "vitest watch test/integration/nuxt4-default.test.ts test/integration/nuxt4-compat5.test.ts",
    "test:integration": "vitest run --maxWorkers=1 test/integration/nuxt4-default.test.ts test/integration/nuxt4-compat5.test.ts test/integration/nuxt4-source-localization.test.ts test/integration/nuxt4-no-i18n.test.ts test/integration/nuxt4-nested-source.test.ts test/integration/nuxt4-nested-premerged.test.ts",
    "test:integration:postgres": "pnpm --filter @nuxt-laravelize/workflows-reliability test:postgres",
    "test:redis": "pnpm --filter @nuxt-laravelize/cache-redis --filter @nuxt-laravelize/filesystem-aws-redis --filter @nuxt-laravelize/queue-bullmq test:redis",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "build:packages": "pnpm -r --filter './packages/**' --if-present run build",
    "test:packages": "pnpm -r --filter './packages/**' --if-present run test",
    "pack:tarballs": "pnpm -r --filter './packages/**' --if-present run pack:test",
    "pack:test": "pnpm run pack:tarballs && node scripts/package-smoke.mjs",
    "docs:packages": "node scripts/generate-package-readmes.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:packages": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run pack:test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
