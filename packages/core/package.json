{
  "name": "@nuxt-laravelize/core",
  "version": "0.1.0",
  "description": "Framework-neutral container and provider lifecycle for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/public-runtime.d.mts",
      "import": "./dist/public-runtime.mjs"
    },
    "./runtime/server": {
      "types": "./dist/public-server.d.mts",
      "import": "./dist/public-server.mjs"
    },
    "./kit": {
      "types": "./dist/kit.d.mts",
      "import": "./dist/kit.mjs"
    },
    "./testing": {
      "types": "./dist/public-testing.d.mts",
      "import": "./dist/public-testing.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "test": "vitest run",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.5",
    "awilix": "^12.0.5"
  },
  "peerDependencies": {
    "nuxt": ">=4.3.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@types/node": "latest",
    "h3": "^1.15.11",
    "nitropack": "^2.13.1",
    "nuxt": "^4.4.5",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
