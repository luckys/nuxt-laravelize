{
  "name": "@luckys_luis/nuxt-laravelize-scheduler",
  "version": "0.2.0",
  "description": "Laravel-like schedules compiled to Nitro 3 tasks",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./nitro3": {
      "types": "./dist/nitro3.d.mts",
      "import": "./dist/nitro3.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "nitro": "3.0.260610-beta"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "nitro": "3.0.260610-beta",
    "rollup": "^4.61.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
