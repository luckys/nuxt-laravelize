{
  "name": "@luckys_luis/nuxt-laravelize-notifications-database-drizzle",
  "version": "0.2.0",
  "description": "Drizzle PostgreSQL, SQLite and Turso stores for database notifications",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    },
    "./sqlite-schema": {
      "types": "./dist/sqlite-schema.d.mts",
      "import": "./dist/sqlite-schema.mjs"
    },
    "./migrations": {
      "types": "./dist/migrations.d.mts",
      "import": "./dist/migrations.mjs"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/postgres.integration.test.ts",
    "test:postgres": "vitest run test/postgres.integration.test.ts",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-migrations": "workspace:^",
    "@luckys_luis/nuxt-laravelize-notifications-database": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.8",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  }
}
