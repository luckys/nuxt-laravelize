{
  "name": "@luckys_luis/nuxt-laravelize-migrations-drizzle",
  "version": "0.3.0",
  "description": "PostgreSQL and SQLite raw-client migration backends",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    },
    "./sources": {
      "types": "./dist/sources.d.mts",
      "import": "./dist/sources.mjs"
    },
    "./migrations": {
      "types": "./dist/sources.d.mts",
      "import": "./dist/sources.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-audit-drizzle": "workspace:^",
    "@luckys_luis/nuxt-laravelize-idempotency-drizzle": "workspace:^",
    "@luckys_luis/nuxt-laravelize-migrations": "workspace:^",
    "@luckys_luis/nuxt-laravelize-notifications-database-drizzle": "workspace:^",
    "@luckys_luis/nuxt-laravelize-reliability-drizzle": "workspace:^",
    "@luckys_luis/nuxt-laravelize-scout-drizzle": "workspace:^",
    "@luckys_luis/nuxt-laravelize-workflows-drizzle": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  }
}
