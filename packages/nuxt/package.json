{
  "name": "@luckys_luis/nuxt-laravelize",
  "version": "0.3.0",
  "description": "Convenience preset for Nuxt Laravelize modules",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/server": {
      "types": "./dist/public-server.d.mts",
      "import": "./dist/public-server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "nuxt-module-build prepare && vitest run --passWithNoTests",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@i18n-micro/core": "1.3.13",
    "@luckys_luis/nuxt-laravelize-audit": "workspace:^",
    "@luckys_luis/nuxt-laravelize-authorization": "workspace:^",
    "@luckys_luis/nuxt-laravelize-broadcasting": "workspace:^",
    "@luckys_luis/nuxt-laravelize-cache": "workspace:^",
    "@luckys_luis/nuxt-laravelize-core": "workspace:^",
    "@luckys_luis/nuxt-laravelize-database": "workspace:^",
    "@luckys_luis/nuxt-laravelize-encryption": "workspace:^",
    "@luckys_luis/nuxt-laravelize-events": "workspace:^",
    "@luckys_luis/nuxt-laravelize-events-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-execution-context": "workspace:^",
    "@luckys_luis/nuxt-laravelize-execution-context-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-filesystem": "workspace:^",
    "@luckys_luis/nuxt-laravelize-hashing": "workspace:^",
    "@luckys_luis/nuxt-laravelize-http": "workspace:^",
    "@luckys_luis/nuxt-laravelize-mail": "workspace:^",
    "@luckys_luis/nuxt-laravelize-notifications": "workspace:^",
    "@luckys_luis/nuxt-laravelize-observability": "workspace:^",
    "@luckys_luis/nuxt-laravelize-pennant": "workspace:^",
    "@luckys_luis/nuxt-laravelize-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-rate-limiter": "workspace:^",
    "@luckys_luis/nuxt-laravelize-reliability": "workspace:^",
    "@luckys_luis/nuxt-laravelize-reliability-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-routes": "workspace:^",
    "@luckys_luis/nuxt-laravelize-scout": "workspace:^",
    "@luckys_luis/nuxt-laravelize-validation": "workspace:^",
    "@nuxt/kit": "^4.5.2",
    "h3": "^1.15.11",
    "nitropack": "^2.13.4",
    "nuxt-i18n-micro": "3.28.0"
  },
  "peerDependencies": {
    "nuxt": ">=4.3.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@types/node": "latest",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
