{
  "name": "@nuxt-laravelize/nuxt",
  "version": "0.2.0",
  "description": "Convenience preset for Nuxt Laravelize modules",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "nuxt-module-build prepare && vitest run --passWithNoTests",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@nuxt-laravelize/cache": "workspace:^",
    "@nuxt-laravelize/core": "workspace:^",
    "@nuxt-laravelize/database": "workspace:^",
    "@nuxt-laravelize/events": "workspace:^",
    "@nuxt-laravelize/encryption": "workspace:^",
    "@nuxt-laravelize/events-queue": "workspace:^",
    "@nuxt-laravelize/filesystem": "workspace:^",
    "@nuxt-laravelize/http": "workspace:^",
    "@nuxt-laravelize/hashing": "workspace:^",
    "@nuxt-laravelize/mail": "workspace:^",
    "@nuxt-laravelize/notifications": "workspace:^",
    "@nuxt-laravelize/queue": "workspace:^",
    "@nuxt-laravelize/rate-limiter": "workspace:^",
    "@nuxt-laravelize/validation": "workspace:^",
    "@nuxt/kit": "^4.4.5",
    "h3": "^1.15.11",
    "nuxt-i18n-micro": "^3.21.4"
  },
  "peerDependencies": {
    "nuxt": ">=4.3.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@types/node": "latest",
    "nuxt": "^4.4.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
