{
  "name": "@luckys_luis/nuxt-laravelize-database-drizzle",
  "version": "1.0.0",
  "description": "Drizzle transaction manager adapter for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-database": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-orm": "^0.44.7",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  }
}
