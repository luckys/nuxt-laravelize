{
  "name": "@luckys_luis/nuxt-laravelize-testing",
  "version": "0.3.0",
  "description": "Aggregate testing harness and fakes for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-audit": "workspace:^",
    "@luckys_luis/nuxt-laravelize-broadcasting": "workspace:^",
    "@luckys_luis/nuxt-laravelize-cache": "workspace:^",
    "@luckys_luis/nuxt-laravelize-core": "workspace:^",
    "@luckys_luis/nuxt-laravelize-execution-context": "workspace:^",
    "@luckys_luis/nuxt-laravelize-encryption": "workspace:^",
    "@luckys_luis/nuxt-laravelize-events": "workspace:^",
    "@luckys_luis/nuxt-laravelize-filesystem": "workspace:^",
    "@luckys_luis/nuxt-laravelize-hashing": "workspace:^",
    "@luckys_luis/nuxt-laravelize-mail": "workspace:^",
    "@luckys_luis/nuxt-laravelize-notifications": "workspace:^",
    "@luckys_luis/nuxt-laravelize-pennant": "workspace:^",
    "@luckys_luis/nuxt-laravelize-scout": "workspace:^",
    "@luckys_luis/nuxt-laravelize-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-rate-limiter": "workspace:^",
    "@luckys_luis/nuxt-laravelize-validation": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
