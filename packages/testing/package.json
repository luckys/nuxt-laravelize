{
  "name": "@nuxt-laravelize/testing",
  "version": "0.2.0",
  "description": "Aggregate testing harness and fakes for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@nuxt-laravelize/audit": "workspace:^",
    "@nuxt-laravelize/cache": "workspace:^",
    "@nuxt-laravelize/core": "workspace:^",
    "@nuxt-laravelize/execution-context": "workspace:^",
    "@nuxt-laravelize/encryption": "workspace:^",
    "@nuxt-laravelize/events": "workspace:^",
    "@nuxt-laravelize/filesystem": "workspace:^",
    "@nuxt-laravelize/hashing": "workspace:^",
    "@nuxt-laravelize/mail": "workspace:^",
    "@nuxt-laravelize/notifications": "workspace:^",
    "@nuxt-laravelize/pennant": "workspace:^",
    "@nuxt-laravelize/scout": "workspace:^",
    "@nuxt-laravelize/queue": "workspace:^",
    "@nuxt-laravelize/rate-limiter": "workspace:^",
    "@nuxt-laravelize/validation": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
