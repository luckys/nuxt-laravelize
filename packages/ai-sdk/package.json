{
  "name": "@luckys_luis/nuxt-laravelize-ai-sdk",
  "version": "0.2.0",
  "description": "Provider-neutral AI SDK integration for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/public-runtime.d.mts",
      "import": "./dist/public-runtime.mjs"
    },
    "./runtime/server": {
      "types": "./dist/public-server.d.mts",
      "import": "./dist/public-server.mjs"
    },
    "./testing": {
      "types": "./dist/public-testing.d.mts",
      "import": "./dist/public-testing.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "test": "nuxt-module-build prepare && vitest run",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-core": "workspace:^",
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "nuxt": ">=4.3.0 <5",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "ai": "^7.0.0",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8",
    "zod": "^4.1.8"
  }
}
