{
  "name": "@luckys_luis/nuxt-laravelize-scout-drizzle",
  "version": "0.3.0",
  "description": "PostgreSQL, SQLite, and Turso/libSQL search engines for Nuxt Laravelize Scout",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    },
    "./turso": {
      "types": "./dist/turso.d.mts",
      "import": "./dist/turso.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    },
    "./sqlite-schema": {
      "types": "./dist/sqlite-schema.d.mts",
      "import": "./dist/sqlite-schema.mjs"
    },
    "./migrations": {
      "types": "./dist/migrations.d.mts",
      "import": "./dist/migrations.mjs"
    },
    "./migrations/0000_create_scout_documents.sql": "./migrations/0000_create_scout_documents.sql",
    "./migrations/0001_create_scout_documents_sqlite.sql": "./migrations/0001_create_scout_documents_sqlite.sql",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-migrations": "workspace:^",
    "@luckys_luis/nuxt-laravelize-scout": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  }
}
