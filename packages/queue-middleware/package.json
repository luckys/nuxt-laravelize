{
  "name": "@luckys_luis/nuxt-laravelize-queue-middleware",
  "version": "0.2.0",
  "description": "Portable overlap, rate-limit and exception-throttle middleware for Nuxt Laravelize queues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/public-runtime.d.mts",
      "import": "./dist/public-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "test": "nuxt-module-build prepare && vitest run",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@luckys_luis/nuxt-laravelize-cache": "workspace:^",
    "@luckys_luis/nuxt-laravelize-core": "workspace:^",
    "@luckys_luis/nuxt-laravelize-queue": "workspace:^",
    "@luckys_luis/nuxt-laravelize-rate-limiter": "workspace:^",
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "nuxt": ">=4.3.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
