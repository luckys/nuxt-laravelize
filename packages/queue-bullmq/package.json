{
  "name": "@nuxt-laravelize/queue-bullmq",
  "version": "0.2.0",
  "description": "Node-only BullMQ driver and worker for Nuxt Laravelize",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "bin": {
    "laravelize-queue-work": "./dist/bin/queue-work.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/public-runtime.d.mts",
      "import": "./dist/public-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "nuxt-module-build prepare && vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@nuxt-laravelize/core": "workspace:^",
    "@nuxt-laravelize/dead-letter": "workspace:^",
    "@nuxt-laravelize/queue": "workspace:^",
    "@nuxt/kit": "^4.4.5",
    "bullmq": "^5.77.3",
    "ioredis": "^5.10.1"
  },
  "peerDependencies": {
    "nuxt": ">=4.3.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@types/node": "latest",
    "nuxt": "^4.4.5",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
