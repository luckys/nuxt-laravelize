{
  "name": "@nuxt-laravelize/scheduler-nuxt",
  "version": "0.2.0",
  "description": "Opt-in Nuxt 4 and Nitro 2 scheduler integration",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./cache-lock": {
      "types": "./dist/cache-lock.d.mts",
      "import": "./dist/cache-lock.mjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.mts",
      "import": "./dist/adapters.mjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.mts",
      "import": "./dist/compiler.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nuxt-module-build build && unbuild --config public.build.config.ts",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "nuxt-module-build prepare && vitest run",
    "prepack": "pnpm run build",
    "pack:test": "pnpm pack --pack-destination ../../.pack"
  },
  "dependencies": {
    "@nuxt-laravelize/cache": "workspace:^",
    "@nuxt-laravelize/scheduler": "workspace:^",
    "@nuxt/kit": "^4.5.2",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "nuxt": ">=4.4.5 <5"
  },
  "devDependencies": {
    "@nuxt-laravelize/cache-redis": "workspace:^",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
