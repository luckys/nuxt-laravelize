{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "eslint.config.mjs",
    "scripts/**/*.mjs",
    "test/integration/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "playground",
    "test/fixtures"
  ]
}
